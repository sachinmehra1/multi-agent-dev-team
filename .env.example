# Copy to .env locally. Never commit real keys.
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
MEMORY_LAST_N=5
EXECUTION_TIMEOUT=10
WORKSPACE_DIR=workspace
CHROMA_DIR=.chroma
# Ollama alternative: LLM_BASE_URL=http://localhost:11434/v1
# Set LLM_MODEL to your installed model; LLM_API_KEY=ollama
# Module 3: total QA rounds (initial review included), supported range 1-20.
QA_MAX_ITERATIONS=5
QA_TIMEOUT_SECONDS=10
# Module 4 deployment, recovery, role allocation and configured cost estimates.
PM_MODEL=gpt-4o
CODER_MODEL=gpt-4o-mini
QA_MODEL=gpt-4o-mini
CALL_MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.25
CIRCUIT_COOLDOWN_SECONDS=30
PROMPT_CACHE_TTL_SECONDS=300
PM_INPUT_USD_PER_MILLION=2.5
PM_OUTPUT_USD_PER_MILLION=10
CODER_INPUT_USD_PER_MILLION=0.15
CODER_OUTPUT_USD_PER_MILLION=0.60
QA_INPUT_USD_PER_MILLION=0.15
QA_OUTPUT_USD_PER_MILLION=0.60
# Local CLI defaults; Compose sets service hostnames automatically.
PHOENIX_TRACES_ENDPOINT=http://localhost:6006/v1/traces
EXECUTION_IMAGE=saras-team:module4
